<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<!-- Package Description-->
	<PropertyGroup>
		<Product>Our.Umbraco.Skipper</Product>
		<PackageId>Our.Umbraco.Skipper</PackageId>
		<Title>Umbraco.Skipper</Title>
		<Description>An Umbraco package that lets you specify nodes and document types that will be excluded from Umbraco's URL generation.</Description>
		<PackageTags>umbraco-marketplace umbraco plugin package</PackageTags>
		<PackageIcon>icon.png</PackageIcon>

		<RepositoryUrl>https://github.com/ZioTino/Our.Umbraco.Skipper</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<ContentTargetFolders>.</ContentTargetFolders>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>symbols.nupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- Author Info + Legal-->
	<PropertyGroup>
		<Authors>ZioTino</Authors>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!-- Assembly Info-->
	<PropertyGroup>
		<RootNamespace>Our.Umbraco.Skipper</RootNamespace>
    <!-- <Version>1.1.5</Version>-->
    <VersionPrefix>18.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)'=='Debug'">prerelease$([System.DateTime]::UtcNow.ToString(`yyyy-MM-dd-HH-mm`))</VersionSuffix>
    <PackageReleaseNotes>
      Support for Umbraco v18
    </PackageReleaseNotes>
	</PropertyGroup>

  <Import Project="Custom.targets" Condition="Exists('Custom.targets')" />

	<!-- Include Package Items -->
	<ItemGroup>
		<None Include="..\LICENSE.md" Pack="true" PackagePath="" />
		<None Include="..\docs\README.md" Pack="true" PackagePath="" />
		<None Include="..\assets\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>


	<!-- Package References -->

  <!--Umbraco 18-->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website"  Version="[18.0.0,19.0.0)" />
  </ItemGroup>


</Project>
